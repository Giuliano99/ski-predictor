{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ski-predictor.local/schemas/season-leaderboard.schema.json",
  "title": "Ski Predictor Season Leaderboard",
  "type": "object",
  "required": ["schemaVersion", "seasonId", "generatedAt", "tipRoundIds", "tipRoundVersions", "standings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seasonId": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tipRoundIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tipRoundVersions": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" }
    },
    "standings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "playerId", "displayName", "seasonPoints", "rounds", "averagePoints"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "playerId": { "type": "string" },
          "displayName": { "type": "string" },
          "seasonPoints": { "type": "integer", "minimum": 0 },
          "rounds": { "type": "integer", "minimum": 1 },
          "averagePoints": { "type": "integer", "minimum": 0, "maximum": 1000 }
        }
      }
    }
  }
}
