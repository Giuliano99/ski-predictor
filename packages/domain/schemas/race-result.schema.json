{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ski-predictor.local/schemas/race-result.schema.json",
  "title": "Ski Predictor Race Result",
  "type": "object",
  "required": ["schemaVersion", "documentType", "raceId", "source", "event", "official", "groups", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "RACE_RESULT" },
    "raceId": { "type": "string", "minLength": 1 },
    "source": { "type": "object" },
    "event": { "type": "object" },
    "official": { "type": "boolean" },
    "matchedStartList": { "type": "string" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "ageClass", "competitionCategory", "classificationMethod", "entries"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "ageClass": { "type": "string" },
          "competitionCategory": { "type": "string" },
          "classificationMethod": { "enum": ["BEST_VALID_RUN", "SUM_OF_RUNS", "SINGLE_RUN", "OFFICIAL_OTHER"] },
          "winnerTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "slowestClassifiedTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "entries": { "type": "array", "items": { "$ref": "#/$defs/resultEntry" } }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "resultEntry": {
      "type": "object",
      "required": ["startNumber", "fullName", "displayName", "birthYear", "club", "targetClub", "status", "runResults"],
      "properties": {
        "startNumber": { "type": "integer", "minimum": 1 },
        "externalAthleteId": { "type": "string" },
        "fullName": { "type": "string" },
        "displayName": { "type": "string" },
        "birthYear": { "type": "integer" },
        "federation": { "type": "string" },
        "club": { "type": "string" },
        "targetClub": { "type": "boolean" },
        "status": { "enum": ["CLASSIFIED", "DNS", "DNF", "DSQ"] },
        "rank": { "type": "integer", "minimum": 1 },
        "officialTimeSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "gapSeconds": { "type": "number", "minimum": 0 },
        "percentageGap": { "type": "number", "minimum": 0 },
        "federationPoints": { "type": "number", "minimum": 0 },
        "runResults": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["runNumber", "status"],
            "properties": {
              "runNumber": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["CLASSIFIED", "DNS", "DNF", "DSQ"] },
              "timeSeconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
